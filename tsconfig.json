{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // No baseUrl: `paths` targets resolve relative to this file. That is also
    // the only form TypeScript 7 accepts (it removed baseUrl outright), so this
    // config typechecks clean on both — the 7.x bump is blocked only by
    // typescript-eslint (typescript-eslint/typescript-eslint#10940).
    "types": ["node", "vscode"],
    "paths": {
      "@px-lsp/protocol/*": ["./packages/protocol/src/*"],
      "@px-lsp/server/dds": ["./packages/server/src/dds/index.ts"],
      "@px-lsp/server/parser": ["./packages/server/src/parser/index.ts"],
      "@px-lsp/server/*": ["./packages/server/src/*"]
    }
  },
  "include": [
    "packages/protocol/src",
    "packages/protocol/test",
    "packages/server/src",
    "packages/server/test",
    "packages/vscode/src",
    "packages/vscode/test",
    "scripts",
    "vitest.config.ts"
  ],
  // The GUI editor's webview app is browser code with its own project (DOM
  // lib, no node/vscode types); `pnpm run typecheck` runs that project too.
  // Its PURE modules still land here through the test imports, which is what
  // keeps them free of DOM types.
  "exclude": ["packages/vscode/src/webviews/guiEditor/app"]
}
