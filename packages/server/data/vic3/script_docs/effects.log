## ordered_country_in_afghanistan
military_marshal_clothes_trigger = {  
	exists = scope:character  
	scope:character = {  
		OR = {  
			AND = {  
				OR = {  
					has_role_of_type = general  
					has_role_of_type = admiral  
				}  
				OR = {  
					commander_rank >= 5  
					is_interest_group_leader = yes # If is IG leader  
				}  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: country  

## ordered_country_in_africa
ai_country_is_valid_colonization_target = {  
	OR = {  
		is_country_type = unrecognized  
		is_country_type = decentralized # Could be useful for the rare cases this is used outside of AI strategies  
	}  
	OR = {  
		is_subject = no  
		top_overlord ?= {  
			is_country_type = unrecognized  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: country  

