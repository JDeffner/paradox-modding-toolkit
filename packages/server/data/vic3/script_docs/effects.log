	scope:pop = {  
		exists = c:FRA  
		home_country = {  
			OR = {  
				AND = {  
					c:FRA = this  
					is_subject = no # preventing uniform conflicts if FRA becomes a subject of another country with puppet uniforms  
				}  
				is_subject_of = c:FRA  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: country  

