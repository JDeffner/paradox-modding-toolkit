# px fixture: mixed tabs and spaces in one file. Rows: W06.
#
# Real .gui files are edited by several people with several editors, so the
# indent unit is not always consistent within one file. The rule under test is
# that the writer copies the indentation of the BODY it is writing into (a
# string prefix, never a counted number of columns, so a tab cannot be mistaken
# for n spaces), and that a paste strips the fragment's own common prefix before
# re-indenting. px_mixed_tabbed is tab-indented, px_mixed_spaced is
# space-indented, and px_mixed_both has a tab-indented entry next to a
# space-indented one inside the same body.

window = {
	name = "px_mixed_window"
	size = { 300 300 }

	widget = {
		name = "px_mixed_tabbed"
		size = { 40 40 }
	}

    widget = {
        name = "px_mixed_spaced"
        size = { 40 40 }
    }

	widget = {
		name = "px_mixed_both"
        size = { 40 40 }
		position = { 10 10 }
	}
}
