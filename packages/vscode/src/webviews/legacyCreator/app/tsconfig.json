{
  // Browser code, not extension-host code: it gets the DOM and NOTHING else
  // (`types: []` — no node, no vscode), so the host API can only reach it
  // through messages.ts. The root tsconfig excludes this folder and typecheck
  // runs this project on top of it.
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "@px-lsp/protocol/*": ["../../../../../protocol/src/*"],
      "@px-lsp/server/*": ["../../../../../server/src/*"]
    }
  },
  "include": ["."]
}
