{
  "if / limit": {
    "prefix": "if",
    "body": ["if = {", "\tlimit = { ${1:condition} }", "\t$0", "}"],
    "description": "if block with a limit trigger"
  },
  "else_if / limit": {
    "prefix": "elseif",
    "body": ["else_if = {", "\tlimit = { ${1:condition} }", "\t$0", "}"],
    "description": "else_if block with a limit trigger"
  },
  "else": {
    "prefix": "else",
    "body": ["else = {", "\t$0", "}"],
    "description": "else block"
  },
  "block": {
    "prefix": "blk",
    "body": ["${1:key} = {", "\t$0", "}"],
    "description": "Key = { } block"
  },
  "PdxDoc comment": {
    "prefix": "pdxdoc",
    "body": [
      "# ${1:What this does.}",
      "# @scope ${2:scope} (${3:what root is})",
      "# @param ${4:PARAM} ${5:what the caller must pass}"
    ],
    "description": "Doc comment the hover cards and completion read"
  }
}
