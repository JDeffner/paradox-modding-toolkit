      {
        "command": "px.runTiger",
        "key": "ctrl+alt+v",
        "when": "editorLangId =~ /^paradox(-(ck3|vic3|eu5))?$/ || editorLangId == paradox-loc || editorLangId == paradox-gui"
      },
      {
        "command": "px.jumpToScriptReference",
