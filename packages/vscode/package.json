{
  "name": "px-toolkit",
  "displayName": "Paradox Modding Toolkit",
  "description": "Modding toolkit for Paradox games (Crusader Kings III, Victoria 3, Europa Universalis V): completion, go-to-definition, hover docs, tiger diagnostics, inline localization, event graph and a visual GUI editor.",
  "version": "0.3.4",
  "publisher": "JDeffner",
  "author": {
    "name": "Joël Deffner"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Formatters",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "paradox",
        "aliases": [
          "Paradox Script"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-light.svg",
          "dark": "./media/fileicons/paradox-dark.svg"
        }
      },
      {
        "id": "paradox-ck3",
        "aliases": [
          "Paradox Script (Crusader Kings III)"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-ck3-light.svg",
          "dark": "./media/fileicons/paradox-ck3-dark.svg"
        }
      },
      {
        "id": "paradox-vic3",
        "aliases": [
          "Paradox Script (Victoria 3)"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-light.svg",
          "dark": "./media/fileicons/paradox-dark.svg"
        }
      },
      {
        "id": "paradox-eu5",
        "aliases": [
          "Paradox Script (Europa Universalis V)"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-light.svg",
          "dark": "./media/fileicons/paradox-dark.svg"
        }
      },
      {
        "id": "paradox-loc",
        "aliases": [
          "Paradox Localization"
        ],
        "configuration": "./loc-language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-loc-light.svg",
          "dark": "./media/fileicons/paradox-loc-dark.svg"
        }
      },
      {
        "id": "paradox-gui",
        "aliases": [
          "Paradox GUI",
          "PdxGui"
        ],
        "configuration": "./gui-language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-gui-light.svg",
          "dark": "./media/fileicons/paradox-gui-dark.svg"
        }
      },
      {
        "id": "paradox-info",
        "aliases": [
          "Paradox Format Docs"
        ],
        "filenamePatterns": [
          "**/_*.info"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-info-light.svg",
          "dark": "./media/fileicons/paradox-info-dark.svg"
        }
      },
      {
        "id": "paradox-mod",
        "aliases": [
          "Paradox Mod Descriptor"
        ],
        "filenames": [
          "descriptor.mod"
        ],
        "filenamePatterns": [
          "**/Paradox Interactive/*/mod/*.mod"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/fileicons/paradox-mod-light.svg",
          "dark": "./media/fileicons/paradox-mod-dark.svg"
        }
      },
      {
        "id": "dds",
        "aliases": [
          "DDS Texture"
        ],
        "extensions": [
          ".dds"
        ],
        "icon": {
          "light": "./media/fileicons/dds-light.svg",
          "dark": "./media/fileicons/dds-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "paradox",
        "scopeName": "source.paradox",
        "path": "./syntaxes/paradox.tmLanguage.json"
      },
      {
        "language": "paradox-ck3",
        "scopeName": "source.paradox-ck3",
        "path": "./syntaxes/paradox-ck3.tmLanguage.json"
      },
      {
        "language": "paradox-vic3",
        "scopeName": "source.paradox-vic3",
        "path": "./syntaxes/paradox-vic3.tmLanguage.json"
      },
      {
        "language": "paradox-eu5",
        "scopeName": "source.paradox-eu5",
        "path": "./syntaxes/paradox-eu5.tmLanguage.json"
      },
      {
        "language": "paradox-loc",
        "scopeName": "source.paradox-loc",
        "path": "./syntaxes/paradox-loc.tmLanguage.json"
      },
      {
        "language": "paradox-gui",
        "scopeName": "source.paradox-gui",
        "path": "./syntaxes/paradox-gui.tmLanguage.json"
      },
      {
        "language": "paradox-info",
        "scopeName": "source.paradox-info",
        "path": "./syntaxes/paradox-info.tmLanguage.json"
      },
      {
        "language": "paradox-mod",
        "scopeName": "source.paradox-mod",
        "path": "./syntaxes/paradox-mod.tmLanguage.json"
      },
      {
        "scopeName": "source.paradox-datafunction",
        "path": "./syntaxes/paradox-datafunction.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[paradox]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[paradox-ck3]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[paradox-vic3]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[paradox-eu5]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[paradox-loc]": {
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestions": {
          "strings": "on"
        }
      },
      "[paradox-gui]": {
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestions": {
          "strings": "on"
        }
      },
      "[paradox-info]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[paradox-mod]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
