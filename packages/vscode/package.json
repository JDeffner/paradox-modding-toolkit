  "scripts": {
    "compile": "pnpm --filter @px-lsp/server run compile && pnpm run compile:client && pnpm run compile:webview && node ../../scripts/copy-server.mjs",
    "compile:client": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --loader:.css=text",
    "compile:webview": "esbuild src/webviews/guiEditor/app/main.ts --bundle --outfile=dist/webview/guiEditor.js --format=iife --platform=browser --target=es2020 && esbuild src/webviews/flagBuilder/app/main.ts --bundle --outfile=dist/webview/flagBuilder.js --format=iife --platform=browser --target=es2020 && esbuild src/webviews/eventGraph/app/main.ts --bundle --outfile=dist/webview/eventGraph.js --format=iife --platform=browser --target=es2020",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --loader:.css=text --watch",
    "vscode:prepublish": "pnpm run compile",
    "package": "vsce package --no-dependencies --githubBranch main --baseImagesUrl https://github.com/JDeffner/paradox-modding-toolkit/raw/main/packages/vscode",
    "testp": "node ../../scripts/package-preview.mjs"
  },
  "devDependencies": {
    "@px-lsp/protocol": "workspace:*",
    "@px-lsp/server": "workspace:*",
    "@types/vscode": "^1.90.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "icon": "media/icon.png",
  "keywords": [
    "ck3",
    "crusader kings",
    "vic3",
    "victoria 3",
    "eu5",
    "europa universalis",
    "paradox",
    "paradox toolkit",
    "modding",
    "language server",
    "tiger"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JDeffner/paradox-modding-toolkit.git"
  }
}
