    "customEditors": [
      {
        "viewType": "px.ddsPreview",
        "displayName": "DDS Preview",
        "selector": [
          {
            "filenamePattern": "*.dds"
          }
        ],
        "priority": "default"
      }
    ],
    "walkthroughs": [
      {
        "id": "px.gettingStarted",
        "title": "Get started with the Paradox Modding Toolkit",
        "description": "Configure the extension and try its features on your mod.",
        "steps": [
          {
            "id": "px.step.setup",
            "title": "Run automatic setup",
            "description": "Detects your game install via Steam, checks the logs folder and offers to download the tiger validator.\n[Run Setup & Health Check](command:px.setup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:px.setup"
            ]
          },
          {
            "id": "px.step.mod",
            "title": "Open your mod folder",
            "description": "Open the folder containing common/, events/ and localization/ as your workspace. The extension indexes it and watches for changes.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "media/walkthrough/mod.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.openFolder"
            ]
          },
          {
            "id": "px.step.scriptdocs",
            "title": "Generate script_docs (recommended)",
            "description": "The bundled wiki data works out of the box; script_docs matches your exact game patch and adds modifiers.\n[Reload Game Data (script_docs)](command:px.reloadScriptDocs)",
            "media": {
              "markdown": "media/walkthrough/scriptdocs.md"
            },
            "completionEvents": [
              "onCommand:px.reloadScriptDocs"
            ]
          },
          {
            "id": "px.step.tiger",
            "title": "Enable tiger diagnostics",
            "description": "tiger validates your whole mod and shows problems as squiggles. Run it with Ctrl+Alt+V or from the tiger item in the status bar; set px.tigerRunOn to 'save' to run it on every save. EU5 has no tiger build yet.\n[Download tiger](command:px.downloadTiger)",
            "media": {
              "markdown": "media/walkthrough/tiger.md"
            },
            "completionEvents": [
              "onCommand:px.downloadTiger",
              "onSettingChanged:px.tigerPath"
            ]
          },
          {
            "id": "px.step.explore",
            "title": "Try it",
            "description": "Open an event file: hover an effect, F12 a scripted effect, check the inline localization.\n[Show Index Statistics](command:px.dumpIndexStats)",
            "media": {
              "markdown": "media/walkthrough/explore.md"
            },
            "completionEvents": [
              "onCommand:px.dumpIndexStats"
            ]
          },
          {
            "id": "px.step.overview",
            "title": "Explore the Paradox view",
            "description": "The Paradox icon in the Activity Bar opens the Project view and the mod overview: content inventory, problems, localization coverage, overrides and the event graph.\n[Show Event Graph](command:px.showEventGraph)\n[Show Mod Report](command:px.modReport)",
            "media": {
              "markdown": "media/walkthrough/overview.md"
            },
            "completionEvents": [
              "onCommand:px.showEventGraph",
              "onCommand:px.modReport"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "Setup",
        "order": 1,
        "properties": {
          "px.gamePath": {
            "type": "string",
            "default": "",
            "order": 1,
            "scope": "machine-overridable",
            "markdownDescription": "Path to the active game's data folder, e.g. `.../steamapps/common/Crusader Kings III/game`. Powers completion, hover and go-to-definition on vanilla content. Which game is active follows `px.gameId`.\n\n**Easiest:** leave empty and run `Paradox: Run Setup & Health Check` — it finds the game via Steam and fills this in. Opening the game folder as an extra workspace folder also works."
          },
          "px.logsPath": {
            "type": "string",
            "default": "",
            "order": 2,
            "scope": "machine-overridable",
            "markdownDescription": "Folder containing the `script_docs` dump files (`triggers.log`, `effects.log`, `event_targets.log`, `modifiers.log`). Leave empty to auto-detect it per game: `Documents/Paradox Interactive/<game>/logs` for CK3, `<game>/docs` for Victoria 3 and EU5.\n\nThe dumps match the engine vocabulary to your exact game version (bundled snapshots are used until you dump your own): launch the game with `-debug_mode`, run `script_docs` in the console (\\`), then run `Paradox: Reload Game Data (script_docs)`."
          },
          "px.tigerPath": {
            "type": "string",
            "default": "",
            "order": 3,
            "scope": "machine-overridable",
            "markdownDescription": "Path to your own tiger binary (`ck3-tiger` or `vic3-tiger`, matching the active game). Leave empty to use the copy installed by `Paradox Tiger: Download or Update Binary` (also offered during Setup)."
          },
          "px.gameId": {
            "type": "string",
            "enum": [
              "auto",
              "ck3",
              "vic3",
              "eu5"
            ],
            "default": "auto",
            "order": 0,
            "enumDescriptions": [
              "Detect from the mod's descriptor shape: descriptor.mod → CK3; .metadata/ plus in_game|main_menu|loading_screen stage folders → EU5; .metadata/ alone → Victoria 3; otherwise CK3.",
              "Crusader Kings III",
              "Victoria 3",
              "Europa Universalis V (community-sourced schema; not yet verified against a live install)"
            ],
            "markdownDescription": "Which game this workspace mods. `auto` detects from the mod's descriptor shape and is right for almost everyone; set explicitly when detection guesses wrong. `px.gamePath`/`px.logsPath`/`px.tigerPath` always describe the ACTIVE game and are honored when set; unset paths are auto-detected per game (Steam library / Documents). Games without a tiger build (EU5) skip tiger integration."
          }
        }
      },
      {
        "title": "Mods",
        "order": 2,
        "properties": {
          "px.modPath": {
            "type": "string",
            "default": "",
            "order": 1,
            "scope": "machine-overridable",
            "markdownDescription": "**Leave this empty** unless your mod folder is not part of the workspace. Every workspace folder that is a mod of the active game is detected and fully indexed automatically. Features follow the file you are editing, and the sidebar views follow it too (or a mod you pin via `Paradox: Pick Focus Mod`)."
          },
          "px.parentMods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 2,
            "scope": "machine-overridable",
            "markdownDescription": "Dependency mods your mod builds on, for submods and compatibility patches. Absolute paths in load order, base first.\n\nParents are read-only context: their definitions resolve in completion, hover and navigation, but they are not validated or edited. Do **not** list mods you are editing — open those as workspace folders instead (*File → Add Folder to Workspace*) and they are picked up automatically.\n\nShareable per-mod alternative: `<mod>/.ck3modding/playset.json` with `{ \"parents\": [\"path/to/parent\"] }`."
          },
          "px.excludedMods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 3,
            "scope": "machine-overridable",
            "markdownDescription": "Workspace mod folders to skip entirely (absolute paths). Excluded mods are not indexed: no completion, hover, navigation, diagnostics or views. Useful when the workspace contains mods you are not currently working on.\n\nEasiest via the per-mod switches in the sidebar Project view, or `Paradox: Exclude Workspace Mods from Indexing`, which shows a checklist of the detected mods."
          },
          "px.locLanguage": {
            "type": "string",
            "default": "english",
            "order": 4,
            "markdownDescription": "Localization language to index and display (matches `l_<language>` yml files), e.g. `english`, `french`, `german`."
          }
        }
      },
      {
        "title": "Validation",
        "order": 3,
        "properties": {
          "px.tigerRunOn": {
            "type": "string",
            "enum": [
              "save",
              "manual"
            ],
            "enumDescriptions": [
              "Run on every save of a mod script file (debounced).",
              "Run only via the 'Paradox Tiger: Run Validation' command."
            ],
            "default": "manual",
            "order": 1,
            "markdownDescription": "When the tiger validator runs (`ck3-tiger` / `vic3-tiger`, whichever matches the active game)."
          },
          "px.diagnostics.ignore": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 2,
            "markdownDescription": "Diagnostic codes to suppress everywhere. Applies to the extension's own structural/localization codes (e.g. `missing-bom`, `unknown-event`) and to tiger report keys (e.g. `unknown-field`).\n\nFor single lines, an inline `# px:ignore <code>` comment does the same."
          },
          "px.diagnostics.ignorePatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 3,
            "markdownDescription": "Glob patterns matched against workspace-relative file paths; all diagnostics (ours and tiger's) in matching files are suppressed. Supports `*` (within a path segment) and `**` (across segments), e.g. `common/**/vendor/*.txt` or `*.generated.txt`."
          },
          "px.diagnostics.vanilla": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "markdownDescription": "Diagnose files under `px.gamePath` (vanilla game content). Off by default: the extension only ever diagnoses your mod's files."
          },
          "px.diagnostics.requireDescriptor": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Report an error (and offer to create one) when a mod folder has no `descriptor.mod` / `.metadata/metadata.json`. Off by default."
          }
        }
      },
      {
        "title": "Editor",
        "order": 4,
        "properties": {
          "px.hover.detail": {
            "type": "string",
            "enum": [
              "compact",
              "standard",
              "full"
            ],
            "enumDescriptions": [
              "Head, facts and provenance only. No prose, no example, one meaning.",
              "Everything, with caps: 3 meanings, 3 example lines, 2 doc paragraphs.",
              "Example cap lifted, every distinct meaning, scope chain always shown."
            ],
            "default": "standard",
            "order": 0,
            "markdownDescription": "How much a hover shows. Longer examples and extra meanings stay reachable from the disclosure inside the hover, so `standard` hides nothing permanently."
          },
          "px.scopeInlayHints": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "markdownDescription": "Show the inferred scope (e.g. `character`) after scope-changing block openers like `every_vassal = {`. Best-effort inference; display only."
          },
          "px.calendar": {
            "type": "object",
            "default": null,
            "order": 6,
            "markdownDescription": "Custom era calendar for total-conversion mods: show how script dates display in game (inlay hints + hover) and enable `Paradox: Insert Date`. Example: `{ \"epoch\": 4000, \"after\": \"AD\", \"before\": \"BC\" }` makes script year 3000 display as `1000 BC` and 4000 as `1 AD`. Optional `months` replaces the standard 12: `[{ \"name\": \"Narvinye\", \"days\": 30 }, ...]`. Set it in the mod's workspace settings and commit it. `Paradox: Generate Calendar Localization` writes the matching game-side loc (era math + date-format overrides) into the mod.",
            "properties": {
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "description": "Script year displayed as year 1 of the later era."
              },
              "after": {
                "type": "string",
                "description": "Era label for script years at or after the epoch (e.g. AD)."
              },
              "before": {
                "type": "string",
                "description": "Era label for script years before the epoch (e.g. BC). Omit for a single-era calendar. Must differ from the later era's label."
              },
              "months": {
                "type": "array",
                "description": "Custom month names and day counts, first month first. Omit for the standard 12 months. The names must be distinct.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "days": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "name",
                    "days"
                  ]
                }
              }
            },
            "required": [
              "epoch",
              "after"
            ]
          },
          "px.enableForWorkspace": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "Escape hatch: set to false to stop this workspace's txt/yml files from being switched to the Paradox language modes."
          },
          "px.sidebar.hidden": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "order": 3,
            "markdownDescription": "Command ids to hide from the Tools section of the sidebar Project panel, e.g. `px.imageGuidelines`. A group whose rows are all hidden disappears with them.\n\nEasiest via `Paradox: Customize Project Panel Rows`, which shows a checklist of every row."
          },
          "px.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "order": 4,
            "markdownDescription": "Trace the communication between VS Code and the language server (for debugging / bug reports)."
          },
          "px.trace.perf": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Log how long the language server spends on each request, file rescan, index change and indexing phase to the *Paradox Modding Toolkit* output channel. Off by default; turn it on when reporting a slow save or slow completion, then paste the `perf …` lines into the report."
          }
        }
      }
    ],
