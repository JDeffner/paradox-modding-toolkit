        "command": "px.showGuiTree",
        "key": "ctrl+alt+w",
        "when": "px.isCk3Workspace && editorLangId == paradox-gui"
      },
      {
        "command": "px.simulateEvent",
        "key": "ctrl+alt+s",
        "when": "px.isCk3Workspace && editorTextFocus && editorLangId =~ /^paradox(-(ck3|vic3|eu5))?$/"
      },
      {
        "command": "px.modReport",
        "key": "ctrl+alt+r",
        "when": "px.isCk3Workspace"
      }
    ]
