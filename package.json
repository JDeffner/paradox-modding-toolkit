{
  "name": "px-lsp",
  "version": "0.3.6",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.22.2"
  },
  "author": {
    "name": "Joël Deffner"
  },
  "scripts": {
    "compile": "pnpm --filter px-toolkit run compile",
    "package:test": "node scripts/package-test.mjs",
    "typecheck": "tsc --noEmit && node scripts/compile-webviews.mjs --typecheck",
    "watch:webviews": "node scripts/compile-webviews.mjs --watch",
    "preview:webviews": "esbuild scripts/webview-preview.ts --bundle --platform=node --external:esbuild --loader:.css=text --outfile=dist/webview-preview.cjs --log-level=warning && node dist/webview-preview.cjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "package": "pnpm --filter px-toolkit run package",
    "testp": "pnpm --filter px-toolkit run testp",
    "bake:browser": "esbuild scripts/bake-browser-data.ts --bundle --platform=node --outfile=dist/bake-browser-data.cjs --log-level=warning && node dist/bake-browser-data.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@px-lsp/protocol": "workspace:*",
    "@px-lsp/server": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.0",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
